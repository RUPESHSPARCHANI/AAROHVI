  "siteContent": {
    "hero": {
      "tagline": "Adorn the Unordinary.",
      "headline": "Indian Adornment, Reimagined.",
      "subheadline": "Challenging the idea that expressive Indian jewellery belongs only to weddings and special occasions. Handcrafted statement pieces, sculptural forms, and oxidised silver aesthetics created for everyday self-expression.",
      "badge": "Contemporary Indian Adornment",
      "ctaPrimary": "Explore Collection",
      "ctaSecondary": "Meet the Founder"
    },
    "announcement": {
      "text": "✨ Free standard shipping across India on orders above ₹499 | Handcrafted oxidised collections",
      "enabled": true
    },
    "philosophy": {
      "quote": "Jewellery is not just something you wear for an occasion. It is a way of expressing who you are.",
      "statement1_title": "Tradition, Without the Rules",
      "statement1_desc": "We bring cultural inspiration together with contemporary fashion. Wear it to college, work, evening strolls, or quiet ordinary days.",
      "statement2_title": "Accessible Self-Expression",
      "statement2_desc": "Everyday luxury shouldn't cost a fortune. Our pieces are thoughtfully priced between ₹100 and ₹800 without compromising on tactile quality.",
      "statement3_title": "Dark Indian Maximalism",
      "statement3_desc": "Bold sculptural forms, deep obsidian charcoal, dramatic oxidized silver, and hints of rich ruby burgundy."
    },
    "founderStory": {
      "founderName": "Tulsi Prakash",
      "role": "Founder & Creative Director",
      "title": "Why should people save the things they love for someday?",
      "paragraphs": [
        "I grew up watching the most breathtaking Indian jewellery locked away inside heavy steel almirahs, brought out only twice a year for weddings or Diwali poojas. The rest of the year, we settled for mundane, lifeless accessories.",
        "AROHVI began with a very clear, stubborn question: why can't we wear evocative, sculptural Indian adornment on a Tuesday afternoon? To college? To an art show? On a solitary coffee run?",
        "AROHVI isn't a generic jewellery shop or an inaccessible bridal house. It is a sanctuary for people who treat personal style as an ongoing creative act. Each piece is designed to be lived in, experimented with, and cherished on the most ordinary of days.",
        "Thank you for being here and adorning the unordinary with us."
      ],
      "quote": "Wear what makes you, you.",
      "image_url": "/images/founder_tulsi.jpg"
    },
    "policies": {
      "shipping": "We ship all across India via reputed express couriers (Bluedart, Delhivery, DTDC). Standard dispatch within 24-48 business hours. Delivery takes 3-5 working days.",
      "returns": "We offer a 7-day hassle-free replacement policy if your piece arrives damaged or with any transit issue. Simply WhatsApp or email our care team.",
      "careGuide": "All AROHVI pieces are made with oxidised alloys. Keep away from harsh chemicals, perfumes, and water. Store in our signature cloth pouch."
    },
    "settings": {
      "freeShippingThreshold": 499,
      "standardShippingFee": 49,
      "supportEmail": "care@arohvi.in",
      "supportPhone": "+91 98201 45892",
      "storeAddress": "AROHVI Design Studio, Bangalore, India"
    }
