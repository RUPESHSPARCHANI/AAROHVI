PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=arohvi_super_secret_jwt_key_2026

# Manager Authentication
MANAGER_EMAIL=tulsi@arohvi.in
MANAGER_USERNAME=admin
MANAGER_PASSWORD=arohvi2026

# Razorpay Payments Integration (Test Mode by Default)
# Sign up at https://dashboard.razorpay.com/ to generate your API keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Automatic Order Confirmation Emails
# Option A: Resend (Recommended, sign up at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="AROHVI Adornments <orders@arohvi.in>"

# Option B: Standard SMTP (Gmail, Brevo, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Supabase Cloud Database & Storage (Recommended Option B)
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=arohvi-products

# Cloudinary Storage Configuration (Optional fallback if not using Supabase Storage)
# Sign up at https://cloudinary.com/ to get your credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=arohvi/products
